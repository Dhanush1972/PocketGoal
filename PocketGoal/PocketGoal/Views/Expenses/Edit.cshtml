@model PocketGoal.ViewModels.ExpenseCreateEditViewModel
@{
    ViewData["Title"] = "Edit Expense";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-md-8 col-lg-6">
        <!-- Breadcrumb -->
        <div class="pg-breadcrumb mb-3">
            <a asp-action="Index"><i class="bi bi-credit-card-2-front"></i> Expense Tracker</a>
            <span class="pg-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
            <span class="pg-breadcrumb-current">Edit Expense</span>
        </div>

        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="stat-icon bg-primary-light text-primary mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Edit Expense</h3>
                <p class="text-muted small mb-0">Expense details update pannikonga</p>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label> <span class="text-danger">*</span>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select" autofocus></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">₹</span>
                        <input asp-for="Amount" class="form-control" type="number" inputmode="decimal" step="any" min="1" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ExpenseDate" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                        <input asp-for="ExpenseDate" class="form-control" type="date" value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" placeholder="Description (optional)" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 text-center">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow" data-loading-text="Updating Expense...">
                        <i class="bi bi-check-lg me-1"></i> Update Expense ✅
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


