@model PocketGoal.ViewModels.ExpenseIndexViewModel
@{
    ViewData["Title"] = "Expense Tracker";
    var months = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var isFiltered = Model.SelectedCategoryId.HasValue || Model.SelectedMonth != DateTime.UtcNow.Month || Model.SelectedYear != DateTime.UtcNow.Year;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Expense Tracker 💸</h2>
        <p class="text-muted mb-0">Un daily and monthly spending categories-ah track pannu.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap flex-sm-nowrap w-100 w-sm-auto">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-grow-1 flex-sm-grow-0" data-bs-toggle="modal" data-bs-target="#customCategoryModal">
            <i class="bi bi-folder-plus me-1"></i> New Category
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm flex-grow-1 flex-sm-grow-0" aria-label="Add New Expense">
            <i class="bi bi-plus-circle me-1"></i> Add Expense
        </a>
    </div>
</div>

<!-- Summary Stat Cards -->
<div class="row g-2 g-sm-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card h-100">
            <div class="text-muted small fw-bold text-uppercase mb-1 text-truncate" style="letter-spacing: 0.03em;">This Month</div>
            <h3 class="fw-bold text-danger mb-0 text-break">₹@Model.CurrentMonthTotal.ToString("N2")</h3>
            <span class="text-muted small d-block text-truncate">@months[Model.SelectedMonth - 1] @Model.SelectedYear</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card h-100">
            <div class="text-muted small fw-bold text-uppercase mb-1 text-truncate" style="letter-spacing: 0.03em;">Today</div>
            <h3 class="fw-bold text-dark mb-0 text-break">₹@Model.TodayTotal.ToString("N2")</h3>
            <span class="text-muted small d-block text-truncate">@DateTime.UtcNow.ToString("MMM dd")</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card h-100">
            <div class="text-muted small fw-bold text-uppercase mb-1 text-truncate" style="letter-spacing: 0.03em;">Last Month</div>
            <h3 class="fw-bold text-muted mb-0 text-break">₹@Model.PreviousMonthTotal.ToString("N2")</h3>
            <span class="text-muted small d-block text-truncate">Comparison baseline</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card h-100">
            <div class="text-muted small fw-bold text-uppercase mb-1 text-truncate" style="letter-spacing: 0.03em;">Total All-Time</div>
            <h3 class="fw-bold text-dark mb-0 text-break">₹@Model.AllTimeTotal.ToString("N2")</h3>
            <span class="text-muted small d-block text-truncate">All-time tracked</span>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="stat-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                <select name="month" class="form-select" aria-label="Filter by month">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.SelectedMonth == i)">@months[i - 1]</option>
                    }
                </select>
                <select name="year" class="form-select" aria-label="Filter by year">
                    @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                <select name="categoryId" class="form-select" aria-label="Filter by category">
                    <option value="">All Categories</option>
                    @foreach (var opt in Model.CategoryOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-12 col-md-3 text-md-end d-flex gap-2 justify-content-start justify-content-md-end flex-wrap flex-sm-nowrap">
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1 flex-md-grow-0">
                <i class="bi bi-filter"></i> Filter
            </button>
            @if (isFiltered)
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-grow-1 flex-md-grow-0 text-center" title="Reset all filters">
                    <i class="bi bi-x-circle me-1"></i> Reset
                </a>
            }
        </div>
    </form>
</div>

<div class="row g-4">
    <!-- Expense Table -->
    <div class="col-12 col-lg-8">
        <div class="stat-card p-3 p-sm-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold text-dark mb-0">Expense Transactions</h5>
                <span class="badge bg-light text-dark border px-2 py-1 flex-shrink-0">@Model.Expenses.Count items</span>
            </div>

            @if (Model.Expenses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model.Expenses)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 min-w-0">
                                            <div class="category-icon-box flex-shrink-0" style="background-color: @(exp.CategoryColor)15; color: @exp.CategoryColor; width: 34px; height: 34px; font-size: 0.95rem;">
                                                <i class="bi @exp.CategoryIcon"></i>
                                            </div>
                                            <span class="fw-semibold text-dark small text-truncate">@exp.CategoryName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small text-nowrap">@exp.ExpenseDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="text-dark small text-break" style="max-width: 200px; display: inline-block;">@(string.IsNullOrEmpty(exp.Description) ? "—" : exp.Description)</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-danger text-nowrap">₹@exp.Amount.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2 flex-nowrap">
                                            <a asp-action="Edit" asp-route-id="@exp.Id" class="btn btn-link text-secondary p-2" aria-label="Edit expense of ₹@exp.Amount.ToString("N2")" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@exp.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-link text-danger p-2" 
                                                        data-bs-confirm="true"
                                                        data-confirm-title="Delete Expense"
                                                        data-confirm-message="Indha <strong>₹@exp.Amount.ToString("N2") (@exp.CategoryName)</strong> expense record-ah delete panna poriya?"
                                                        data-confirm-btn-text="Yes, Delete Expense"
                                                        aria-label="Delete expense of ₹@exp.Amount.ToString("N2")"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt-cutoff text-muted display-4"></i>
                    <h6 class="fw-bold text-dark mt-3">No Expenses Found</h6>
                    <p class="text-muted small mb-3">Selected filter or month-la expenses onnum record aagala.</p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4">
                            <i class="bi bi-plus-lg me-1"></i> Add Expense
                        </a>
                        @if (isFiltered)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                Clear All Filters
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Category Breakdown Column -->
    <div class="col-12 col-lg-4">
        <div class="stat-card p-3 p-sm-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-pie-chart text-primary me-2"></i> Category Breakdown
            </h5>

            @if (Model.CategorySummaries.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var cat in Model.CategorySummaries)
                    {
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-1">
                                <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
                                    <span class="category-dot flex-shrink-0" style="background-color: @cat.CategoryColor;"></span>
                                    <span class="fw-semibold text-dark small text-truncate">@cat.CategoryName</span>
                                </div>
                                <div class="text-end flex-shrink-0 ms-2">
                                    <span class="fw-bold text-dark small text-nowrap">₹@cat.TotalAmount.ToString("N0")</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">(@cat.PercentageOfTotal%)</span>
                                </div>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar" role="progressbar" style="width: @cat.PercentageOfTotal%; background-color: @cat.CategoryColor;" aria-valuenow="@cat.PercentageOfTotal" aria-valuemin="0" aria-valuemax="100" aria-label="Category @cat.CategoryName percentage"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-4">Indha period-la data onnum illa da.</p>
            }
        </div>
    </div>
</div>

<!-- Modal: Create Custom Category -->
<div class="modal fade" id="customCategoryModal" tabindex="-1" aria-labelledby="customCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="customCategoryModalLabel">Create Custom Category</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="customCategoryName">Category Name</label> <span class="text-danger">*</span>
                        <input type="text" id="customCategoryName" name="Name" class="form-control" placeholder="e.g. Subscriptions, Gadgets, Pets" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customCategoryIcon">Icon</label>
                        <select id="customCategoryIcon" name="Icon" class="form-select">
                            <option value="bi-tag">Tag (Default)</option>
                            <option value="bi-controller">Gaming</option>
                            <option value="bi-house">Rent / Housing</option>
                            <option value="bi-cup-hot">Coffee / Snacks</option>
                            <option value="bi-gift">Gifts</option>
                            <option value="bi-camera">Photography</option>
                            <option value="bi-wrench">Repairs & Maintenance</option>
                            <option value="bi-car-front">Transport / Fuel</option>
                            <option value="bi-heart-pulse">Health / Medical</option>
                            <option value="bi-book">Books / Education</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="categoryColorInput">Theme Color</label>
                        <!-- Quick Color Swatches -->
                        <div class="color-swatches-grid mb-2">
                            <button type="button" class="color-swatch-btn active" style="background-color: #6366f1;" data-color="#6366f1" aria-label="Indigo"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #0ea5e9;" data-color="#0ea5e9" aria-label="Sky Blue"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #10b981;" data-color="#10b981" aria-label="Emerald Green"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #f59e0b;" data-color="#f59e0b" aria-label="Amber"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #ef4444;" data-color="#ef4444" aria-label="Red"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #ec4899;" data-color="#ec4899" aria-label="Pink"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #8b5cf6;" data-color="#8b5cf6" aria-label="Purple"></button>
                            <button type="button" class="color-swatch-btn" style="background-color: #14b8a6;" data-color="#14b8a6" aria-label="Teal"></button>
                        </div>
                        <input type="color" id="categoryColorInput" name="ColorHex" class="form-control form-control-color w-100" value="#6366f1" style="height: 38px;" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" data-loading-text="Creating Category...">Create Category 🚀</button>
                </div>
            </form>
        </div>
    </div>
</div>


