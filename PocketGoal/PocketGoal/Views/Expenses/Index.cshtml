@model PocketGoal.ViewModels.ExpenseIndexViewModel
@{
    ViewData["Title"] = "Expense Tracker";
    var months = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Expense Tracker 💸</h2>
        <p class="text-muted mb-0">Un daily and monthly spending categories-ah track pannu.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap flex-sm-nowrap w-100 w-sm-auto">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-3 flex-grow-1 flex-sm-grow-0" data-bs-toggle="modal" data-bs-target="#customCategoryModal">
            <i class="bi bi-folder-plus me-1"></i> + New Category
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm flex-grow-1 flex-sm-grow-0">
            <i class="bi bi-plus-circle me-1"></i> + Add Expense
        </a>
    </div>
</div>

<!-- Summary Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="text-muted small fw-bold text-uppercase mb-1">This Month Spending</div>
            <h3 class="fw-bold text-danger mb-0">₹@Model.CurrentMonthTotal.ToString("N2")</h3>
            <span class="text-muted small">@months[Model.SelectedMonth - 1] @Model.SelectedYear</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="text-muted small fw-bold text-uppercase mb-1">Today's Expenses</div>
            <h3 class="fw-bold text-dark mb-0">₹@Model.TodayTotal.ToString("N2")</h3>
            <span class="text-muted small">@DateTime.UtcNow.ToString("MMM dd")</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="text-muted small fw-bold text-uppercase mb-1">Last Month</div>
            <h3 class="fw-bold text-muted mb-0">₹@Model.PreviousMonthTotal.ToString("N2")</h3>
            <span class="text-muted small">Comparison baseline</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="text-muted small fw-bold text-uppercase mb-1">Total Expenses</div>
            <h3 class="fw-bold text-dark mb-0">₹@Model.AllTimeTotal.ToString("N2")</h3>
            <span class="text-muted small">All-time tracked</span>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="stat-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                <select name="month" class="form-select form-select-sm">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.SelectedMonth == i)">@months[i - 1]</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-funnel"></i> Category</span>
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var opt in Model.CategoryOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-md-3 text-md-end d-flex gap-2 justify-content-start justify-content-md-end">
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1 flex-md-grow-0">
                <i class="bi bi-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-grow-1 flex-md-grow-0">Reset</a>
        </div>
    </form>
</div>

<div class="row g-4">
    <!-- Expense Table -->
    <div class="col-lg-8">
        <div class="stat-card p-3 p-sm-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Expense Transactions</h5>
                <span class="badge bg-light text-dark border">@Model.Expenses.Count items</span>
            </div>

            @if (Model.Expenses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model.Expenses)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="category-icon-box" style="background-color: @(exp.CategoryColor)15; color: @exp.CategoryColor; width: 32px; height: 32px; font-size: 0.9rem;">
                                                <i class="bi @exp.CategoryIcon"></i>
                                            </div>
                                            <span class="fw-semibold text-dark small">@exp.CategoryName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@exp.ExpenseDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="text-dark small">@(string.IsNullOrEmpty(exp.Description) ? "—" : exp.Description)</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-danger">₹@exp.Amount.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@exp.Id" class="text-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@exp.Id" method="post" class="d-inline" onsubmit="return confirm('Indha expense record-ah delete panna poriya?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link text-danger p-0" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt-cutoff text-muted display-4"></i>
                    <h6 class="fw-bold text-dark mt-3">No Expenses Found</h6>
                    <p class="text-muted small">Selected filter or month-la expenses onnum record aagala.</p>
                    <a asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        + Add Expense
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Category Breakdown Column -->
    <div class="col-lg-4">
        <div class="stat-card p-3 p-sm-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-pie-chart text-primary me-2"></i> Category Breakdown
            </h5>

            @if (Model.CategorySummaries.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var cat in Model.CategorySummaries)
                    {
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="category-dot" style="background-color: @cat.CategoryColor;"></span>
                                    <span class="fw-semibold text-dark small">@cat.CategoryName</span>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-dark small">₹@cat.TotalAmount.ToString("N0")</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">(@cat.PercentageOfTotal%)</span>
                                </div>
                            </div>
                            <div class="progress" style="height: 6px; border-radius: 3px;">
                                <div class="progress-bar" role="progressbar" style="width: @cat.PercentageOfTotal%; background-color: @cat.CategoryColor;" aria-valuenow="@cat.PercentageOfTotal" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-4">Indha period-la data onnum illa da.</p>
            }
        </div>
    </div>
</div>

<!-- Modal: Create Custom Category -->
<div class="modal fade" id="customCategoryModal" tabindex="-1" aria-labelledby="customCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="customCategoryModalLabel">Create Custom Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name</label> <span class="text-danger">*</span>
                        <input type="text" name="Name" class="form-control" placeholder="Enter category name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Icon (Bootstrap Icons class)</label>
                        <select name="Icon" class="form-select">
                            <option value="bi-tag">Tag (Default)</option>
                            <option value="bi-controller">Gaming</option>
                            <option value="bi-house">Rent / Housing</option>
                            <option value="bi-cup-hot">Coffee / Snacks</option>
                            <option value="bi-gift">Gifts</option>
                            <option value="bi-camera">Photography</option>
                            <option value="bi-wrench">Repairs & Maintenance</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Theme Color</label>
                        <input type="color" name="ColorHex" class="form-control form-control-color w-100" value="#6366f1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Category 🚀</button>
                </div>
            </form>
        </div>
    </div>
</div>
