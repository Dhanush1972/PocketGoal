@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-lg-8">
        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Privacy Policy</h3>
                    <span class="text-muted small">PocketGoal Data & Security Information</span>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-4">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-check2-circle text-success me-1"></i> Data Privacy First</h6>
                <p class="text-muted small mb-0">
                    Your financial goals, savings records, and expense entries are safely stored in your dedicated PostgreSQL database. PocketGoal does not share your financial information with third parties.
                </p>
            </div>

            <h6 class="fw-bold text-dark mb-2">Profile & Identity</h6>
            <p class="text-muted small mb-4">
                We identify your active session via your profile context or session cookie. No complicated passwords or intrusive tracking are required to manage your goals and expenses.
            </p>

            <h6 class="fw-bold text-dark mb-2">Notifications & Delivery</h6>
            <p class="text-muted small mb-4">
                Reminders and pacing alerts are dispatched through secure email and SMS gateways configured on your server environment.
            </p>

            <div class="pt-3 border-top text-center text-sm-start">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 w-100 w-sm-auto">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

