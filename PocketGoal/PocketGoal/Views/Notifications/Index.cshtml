@model PocketGoal.ViewModels.NotificationCenterViewModel
@{
    ViewData["Title"] = "Savings Reminders & Notifications";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Savings Reminders & Notifications 🔔</h2>
        <p class="text-muted mb-0">Un monthly savings targets, pacing alerts, and milestone updates ellam inga paathuko.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Reminders List -->
    <div class="col-12 col-lg-8">
        <div class="stat-card p-3 p-sm-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-bell-fill text-primary me-2"></i> Active Goal Reminders
            </h5>

            @if (Model.GeneratedReminders.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.GeneratedReminders)
                    {
                        <div class="p-3 rounded-3 border bg-white shadow-xs">
                            <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 flex-wrap">
                                    <span class="badge @item.UrgencyBadge flex-shrink-0" style="font-size: 0.75rem; border-radius: var(--pg-radius-pill);">
                                        @item.Type
                                    </span>
                                    <strong class="text-dark text-truncate">@item.Title</strong>
                                </div>
                                <span class="text-muted small flex-shrink-0">@item.GeneratedAt.ToString("MMM dd, yyyy")</span>
                            </div>

                            <div class="p-3 bg-light rounded-2 border mb-3">
                                <div class="text-muted small fw-bold mb-1"><i class="bi bi-envelope me-1 text-primary"></i> Email Preview (@Model.User.Email):</div>
                                <div class="text-dark small mb-1 fw-bold text-break">@item.Subject</div>
                                <div class="text-muted small text-break">@item.MessageBody</div>

                                <hr class="my-2 opacity-25" />

                                <div class="text-muted small fw-bold mb-1"><i class="bi bi-chat-dots me-1 text-primary"></i> SMS Preview (@Model.User.PhoneNumber):</div>
                                <div class="text-dark small text-break">@item.SmsBody</div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <form asp-action="Trigger" method="post" class="d-inline w-100 w-sm-auto text-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="GoalId" value="@item.GoalId" />
                                    <input type="hidden" name="Type" value="@item.Type" />
                                    <input type="hidden" name="Channel" value="@PocketGoal.Models.NotificationChannel.Both" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100 w-sm-auto" data-loading-text="Sending Alert...">
                                        <i class="bi bi-send-fill me-1"></i> Send Test Notification 🚀
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-light rounded-3">
                    <i class="bi bi-check-circle text-success display-4"></i>
                    <h5 class="fw-bold text-dark mt-3">All Caught Up! 🎉</h5>
                    <p class="text-muted small mb-3">Pending pacing alerts or urgent deadlines onnum illa da. Un savings goals ellam track-la pogudhu.</p>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-pie-chart-fill me-1"></i> Go to Dashboard
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Notification Provider & Channel Settings -->
    <div class="col-12 col-lg-4">
        <div class="stat-card p-3 p-sm-4 mb-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-sliders text-primary me-2"></i> Delivery Channels
            </h5>

            <div class="mb-3 p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-1">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <i class="bi bi-envelope-check text-primary fs-5 flex-shrink-0"></i>
                        <span class="fw-bold text-dark small text-truncate">Email Notifications</span>
                    </div>
                    <span class="badge bg-success-light text-success border flex-shrink-0">Active</span>
                </div>
                <div class="text-muted small text-truncate">Target: <strong class="text-dark">@Model.User.Email</strong></div>
                <div class="text-muted" style="font-size: 0.75rem;">Provider: @Model.EmailProviderName</div>
            </div>

            <div class="mb-3 p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-1">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <i class="bi bi-phone-vibrate text-primary fs-5 flex-shrink-0"></i>
                        <span class="fw-bold text-dark small text-truncate">SMS / Phone Alerts</span>
                    </div>
                    <span class="badge bg-success-light text-success border flex-shrink-0">Active</span>
                </div>
                <div class="text-muted small text-truncate">Target: <strong class="text-dark">@Model.User.PhoneNumber</strong></div>
                <div class="text-muted" style="font-size: 0.75rem;">Provider: @Model.SmsProviderName</div>
            </div>

            <div class="p-3 bg-primary-light rounded-3 border border-primary text-primary small">
                <i class="bi bi-shield-check me-1"></i> Notification credentials and provider endpoints are stored securely on the server.
            </div>
        </div>
    </div>
</div>

