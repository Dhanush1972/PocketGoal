@model PocketGoal.ViewModels.OnboardingViewModel
@{
    ViewData["Title"] = "Get Started - Set Your Saving Goal";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-lg-10 col-xl-9">
        <div class="onboarding-card">
            <!-- Hero Header -->
            <div class="onboarding-hero">
                <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle mb-3 shadow-sm" style="width: 60px; height: 60px; font-size: 1.75rem;">
                    <i class="bi bi-piggy-bank-fill"></i>
                </div>
                <h1 class="h3 fw-bold mb-2 text-white">Welcome to PocketGoal! 👋</h1>
                <p class="mb-0 text-white-50 mx-auto" style="max-width: 580px; font-size: 0.95rem;">
                    Un dream purchase target set pannu, monthly savings plan ready pannu, daily expenses easy-ah track pannu — no complicated passwords required!
                </p>
            </div>

            <!-- Form Body -->
            <div class="p-3 p-sm-4 p-md-5">
                <form asp-action="Onboarding" method="post" id="onboardingForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- Step 1: Your Profile Details -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.875rem; font-weight: 700;">1</span>
                            <h5 class="fw-bold mb-0 text-dark">Step 1: Your Profile Details</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Dhanush" autofocus />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" type="email" inputmode="email" placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PhoneNumber" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="tel" placeholder="9876543210" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Step 2: What Are You Saving For? -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.875rem; font-weight: 700;">2</span>
                            <h5 class="fw-bold mb-0 text-dark">Step 2: What Are You Saving For?</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="GoalName" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-bullseye"></i></span>
                                    <input asp-for="GoalName" class="form-control" id="goalNameInput" placeholder="e.g. MacBook Pro, iPhone 16, Goa Trip" />
                                </div>
                                <span asp-validation-for="GoalName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TargetPrice" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">₹</span>
                                    <input asp-for="TargetPrice" class="form-control" type="number" inputmode="numeric" step="100" min="100" id="targetPriceInput" placeholder="80000" />
                                </div>
                                <span asp-validation-for="TargetPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SavingPeriodMonths" class="form-label"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                                    <select asp-for="SavingPeriodMonths" class="form-select" id="periodMonthsSelect">
                                        <option value="1">1 Month</option>
                                        <option value="2">2 Months</option>
                                        <option value="3">3 Months</option>
                                        <option value="4" selected>4 Months</option>
                                        <option value="6">6 Months</option>
                                        <option value="9">9 Months</option>
                                        <option value="12">1 Year (12 Months)</option>
                                        <option value="18">1.5 Years (18 Months)</option>
                                        <option value="24">2 Years (24 Months)</option>
                                        <option value="36">3 Years (36 Months)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="SavingPeriodMonths" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="InitialSavings" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">₹</span>
                                    <input asp-for="InitialSavings" class="form-control" type="number" inputmode="numeric" step="100" min="0" placeholder="0" id="initialSavingsInput" />
                                </div>
                                <span asp-validation-for="InitialSavings" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="GoalDescription" class="form-label"></label>
                                <textarea asp-for="GoalDescription" class="form-control" rows="2" placeholder="Optional notes or details"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Instant Interactive Calculation Preview Card -->
                    <div class="p-3 p-md-4 rounded-3 border bg-light mb-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-calculator text-primary fs-5"></i>
                                <span>Estimated Savings Breakdown 📊</span>
                            </div>
                            <span class="badge bg-primary-light text-primary border px-3 py-1 fw-bold" id="previewGoalTitle">Your Goal</span>
                        </div>

                        <div class="row g-3 text-center">
                            <div class="col-6 col-md-3">
                                <div class="p-2 bg-white rounded-3 border">
                                    <div class="text-muted small">Target Price</div>
                                    <div class="h5 fw-bold text-dark mb-0 mt-1" id="previewTargetPrice">₹0</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 bg-white rounded-3 border">
                                    <div class="text-muted small">Balance to Save</div>
                                    <div class="h5 fw-bold text-primary mb-0 mt-1" id="previewRemaining">₹0</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 bg-white rounded-3 border">
                                    <div class="text-muted small">Monthly Target</div>
                                    <div class="h5 fw-bold text-success mb-0 mt-1" id="previewMonthly">₹0</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 bg-white rounded-3 border">
                                    <div class="text-muted small">Daily Target</div>
                                    <div class="h5 fw-bold text-secondary mb-0 mt-1" id="previewDaily">₹0</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 pt-2">
                        <a asp-action="Switch" class="text-muted text-decoration-none small text-center text-sm-start">
                            <i class="bi bi-person-check me-1 text-primary"></i> Already profile irukka? Switch pannunga
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow w-100 w-sm-auto" data-loading-text="Setting up Profile...">
                            <i class="bi bi-rocket-takeoff-fill me-2"></i> Start Saving Now 🚀
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateCalculationPreview() {
            const goalName = document.getElementById('goalNameInput').value || 'Your Goal';
            const price = parseFloat(document.getElementById('targetPriceInput').value) || 0;
            const initial = parseFloat(document.getElementById('initialSavingsInput').value) || 0;
            const months = parseInt(document.getElementById('periodMonthsSelect').value) || 1;

            const remaining = Math.max(0, price - initial);
            const monthly = months > 0 ? (remaining / months) : remaining;
            const days = months * 30;
            const daily = days > 0 ? (remaining / days) : remaining;

            document.getElementById('previewGoalTitle').textContent = goalName;
            document.getElementById('previewTargetPrice').textContent = '₹' + price.toLocaleString('en-IN');
            document.getElementById('previewRemaining').textContent = '₹' + remaining.toLocaleString('en-IN');
            document.getElementById('previewMonthly').textContent = '₹' + Math.round(monthly).toLocaleString('en-IN');
            document.getElementById('previewDaily').textContent = '₹' + Math.round(daily).toLocaleString('en-IN');
        }

        document.getElementById('goalNameInput').addEventListener('input', updateCalculationPreview);
        document.getElementById('targetPriceInput').addEventListener('input', updateCalculationPreview);
        document.getElementById('initialSavingsInput').addEventListener('input', updateCalculationPreview);
        document.getElementById('periodMonthsSelect').addEventListener('change', updateCalculationPreview);

        // Initial run
        updateCalculationPreview();
    </script>
}

