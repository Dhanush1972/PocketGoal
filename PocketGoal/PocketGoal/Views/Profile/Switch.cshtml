@model PocketGoal.ViewModels.ProfileSwitchViewModel
@{
    ViewData["Title"] = "Select Profile";
    var activeId = Model?.ActiveProfileId;
    var profiles = Model?.AvailableProfiles ?? new List<PocketGoal.Models.UserProfile>();
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-md-8 col-lg-6">
        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Select Profile & Sign In</h3>
                <p class="text-muted small mb-0">Un profile select panni password enter pannunga, illa email/phone vechu login pannunga</p>
            </div>

            <!-- Direct Login by Email/Phone + Password -->
            <div class="mb-4 p-3 bg-light rounded-3 border">
                <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-box-arrow-in-right me-1 text-primary"></i> Direct Login</h6>
                <form asp-action="LookupProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1" for="directLoginEmail">Email or Phone Number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" id="directLoginEmail" name="emailOrPhone" class="form-control" placeholder="name@example.com / 9876543210" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1" for="directLoginPassword">Password</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" id="directLoginPassword" name="lookupPassword" class="form-control" placeholder="Enter your password" required />
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm w-100 rounded-pill" type="submit" data-loading-text="Authenticating...">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Account
                    </button>
                </form>
            </div>

            @if (profiles.Any())
            {
                <h6 class="fw-bold text-muted small text-uppercase mb-3" style="letter-spacing: 0.04em;">Available Profiles On This Device</h6>
                <div class="d-flex flex-column gap-2 mb-4">
                    @foreach (var user in profiles)
                    {
                        var isActive = activeId.HasValue && activeId.Value == user.Id;
                        <div class="p-3 rounded-3 border bg-white d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 @(isActive ? "border-primary bg-primary-light shadow-xs" : "")">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 42px; height: 42px; font-size: 1rem;">
                                    @user.Name.Substring(0, Math.Min(1, user.Name.Length)).ToUpper()
                                </div>
                                <div class="text-truncate">
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                        <span>@user.Name</span>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-primary text-white" style="font-size: 0.7rem;">Active</span>
                                        }
                                    </div>
                                    <div class="text-muted small text-truncate">@user.Email &bull; @user.PhoneNumber</div>
                                </div>
                            </div>
                            <div class="w-100 w-sm-auto text-end">
                                @if (!isActive)
                                {
                                    <button type="button" 
                                            class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100 w-sm-auto switch-profile-btn" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#profilePasswordModal"
                                            data-profile-id="@user.Id"
                                            data-profile-name="@user.Name"
                                            data-profile-email="@user.Email"
                                            aria-label="Switch to @user.Name's profile">
                                        <i class="bi bi-lock me-1"></i> Switch Profile
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3 w-100 w-sm-auto">
                                        Open Dashboard
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 bg-light rounded-3 mb-4">
                    <i class="bi bi-person-x text-muted fs-3"></i>
                    <p class="text-muted small mt-2 mb-0">No profiles found. Create your first profile below!</p>
                </div>
            }

            <div class="text-center pt-2 border-top">
                <a asp-action="Onboarding" class="btn btn-outline-primary rounded-pill px-4 w-100 w-sm-auto">
                    <i class="bi bi-plus-circle me-1"></i> Create New Profile & Goal
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Profile Password Authentication -->
<div class="modal fade" id="profilePasswordModal" tabindex="-1" aria-labelledby="profilePasswordModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="profilePasswordModalTitle">
                    <i class="bi bi-shield-lock text-primary me-1"></i> Authenticate Profile
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SelectProfile" method="post" id="selectProfilePasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="profileId" id="modalProfileId" value="" />

                <div class="modal-body pt-3 pb-2">
                    <div class="p-3 bg-light rounded-3 border mb-3 text-center">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-2" id="modalProfileAvatar" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            U
                        </div>
                        <h6 class="fw-bold text-dark mb-0" id="modalProfileName">User Name</h6>
                        <span class="text-muted small" id="modalProfileEmail">email@example.com</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="modalProfilePassword">Profile Password</label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="password" name="switchPassword" id="modalProfilePassword" class="form-control" placeholder="Enter password to switch" required autocomplete="current-password" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" title="Show/Hide Password">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <div class="form-text small">Indha profile-ku set pannina password-ah enter pannunga.</div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" data-loading-text="Authenticating...">
                        <i class="bi bi-unlock-fill me-1"></i> Unlock & Switch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordModal = document.getElementById('profilePasswordModal');
            if (passwordModal) {
                passwordModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;

                    const profileId = button.getAttribute('data-profile-id');
                    const profileName = button.getAttribute('data-profile-name');
                    const profileEmail = button.getAttribute('data-profile-email');

                    document.getElementById('modalProfileId').value = profileId;
                    document.getElementById('modalProfileName').textContent = profileName;
                    document.getElementById('modalProfileEmail').textContent = profileEmail;
                    document.getElementById('modalProfileAvatar').textContent = (profileName || 'U').charAt(0).toUpperCase();

                    const passInput = document.getElementById('modalProfilePassword');
                    if (passInput) {
                        passInput.value = '';
                        setTimeout(() => passInput.focus(), 300);
                    }
                });
            }

            // Toggle show/hide password in modal
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passInput = document.getElementById('modalProfilePassword');
            const toggleIcon = document.getElementById('togglePasswordIcon');
            if (toggleBtn && passInput && toggleIcon) {
                toggleBtn.addEventListener('click', function () {
                    if (passInput.type === 'password') {
                        passInput.type = 'text';
                        toggleIcon.classList.remove('bi-eye');
                        toggleIcon.classList.add('bi-eye-slash');
                    } else {
                        passInput.type = 'password';
                        toggleIcon.classList.remove('bi-eye-slash');
                        toggleIcon.classList.add('bi-eye');
                    }
                });
            }
        });
    </script>
}
