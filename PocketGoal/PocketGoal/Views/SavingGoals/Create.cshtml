@model PocketGoal.ViewModels.SavingGoalCreateEditViewModel
@{
    ViewData["Title"] = "Create Saving Goal";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-12 col-md-8 col-lg-6">
        <!-- Breadcrumb -->
        <div class="pg-breadcrumb mb-3">
            <a asp-action="Index"><i class="bi bi-bullseye"></i> Saving Goals</a>
            <span class="pg-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
            <span class="pg-breadcrumb-current">Create New Goal</span>
        </div>

        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.45rem;">
                    <i class="bi bi-bullseye"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Create Saving Goal</h3>
                <p class="text-muted small mb-0">Un target purchase and time plan set pannu</p>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="GoalName" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tag"></i></span>
                        <input asp-for="GoalName" class="form-control" placeholder="e.g. New Laptop, Vacation, Bike" autofocus />
                    </div>
                    <span asp-validation-for="GoalName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetAmount" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">₹</span>
                        <input asp-for="TargetAmount" id="targetAmountInput" class="form-control" type="number" inputmode="numeric" step="100" min="1" placeholder="50000" />
                    </div>
                    <!-- Quick Target Amount Chips -->
                    <div class="quick-chip-group">
                        <span class="quick-chip" data-target-input="targetAmountInput" data-amount="10000">₹10,000</span>
                        <span class="quick-chip" data-target-input="targetAmountInput" data-amount="25000">₹25,000</span>
                        <span class="quick-chip" data-target-input="targetAmountInput" data-amount="50000">₹50,000</span>
                        <span class="quick-chip" data-target-input="targetAmountInput" data-amount="100000">₹1,00,000</span>
                    </div>
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetDate" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                        <input asp-for="TargetDate" id="targetDateInput" class="form-control" type="date" value="@DateTime.UtcNow.AddMonths(6).ToString("yyyy-MM-dd")" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>
                    <!-- Quick Duration Chips -->
                    <div class="quick-chip-group" id="quickDurationChips">
                        <span class="quick-chip" data-months="3">3 Months</span>
                        <span class="quick-chip active" data-months="6">6 Months</span>
                        <span class="quick-chip" data-months="12">1 Year</span>
                        <span class="quick-chip" data-months="24">2 Years</span>
                    </div>
                    <span asp-validation-for="TargetDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional notes or details"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 text-center">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow" data-loading-text="Creating Goal...">
                        <i class="bi bi-check-lg me-1"></i> Save Goal 🚀
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Quick duration chip helpers for setting target date
        document.querySelectorAll('#quickDurationChips .quick-chip').forEach(function(chip) {
            chip.addEventListener('click', function() {
                const months = parseInt(chip.getAttribute('data-months')) || 6;
                const d = new Date();
                d.setMonth(d.getMonth() + months);
                const yyyy = d.getFullYear();
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const dd = String(d.getDate()).padStart(2, '0');
                
                const dateInput = document.getElementById('targetDateInput');
                if (dateInput) {
                    dateInput.value = `${yyyy}-${mm}-${dd}`;
                }
                document.querySelectorAll('#quickDurationChips .quick-chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
            });
        });
    </script>
}


