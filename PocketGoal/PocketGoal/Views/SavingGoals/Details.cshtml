@model PocketGoal.ViewModels.SavingGoalViewModel
@{
    ViewData["Title"] = Model.GoalName + " - Goal Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Goals</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.GoalName</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-0">@Model.GoalName</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> Edit Goal
        </a>
        @if (!Model.IsCompleted)
        {
            <a asp-controller="Savings" asp-action="Add" asp-route-goalId="@Model.Id" class="btn btn-success btn-sm rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i> Record Deposit
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Goal Metrics Card -->
    <div class="col-lg-7">
        <div class="stat-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-light text-dark border">
                    <i class="bi bi-calendar3 me-1"></i> Deadline: @Model.TargetDate.ToString("MMMM dd, yyyy")
                </span>
                <div>
                    @if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.Completed)
                    {
                        <span class="badge-pace-completed"><i class="bi bi-check-circle-fill"></i> Completed</span>
                    }
                    else if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.OnTrack)
                    {
                        <span class="badge-pace-ontrack"><i class="bi bi-speedometer"></i> On Track</span>
                    }
                    else if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.Behind)
                    {
                        <span class="badge-pace-behind"><i class="bi bi-exclamation-triangle-fill"></i> Behind Pace</span>
                    }
                    else
                    {
                        <span class="badge-pace-overdue"><i class="bi bi-clock-history"></i> Overdue</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted mb-4">@Model.Description</p>
            }

            <!-- Progress Bar -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <div>
                        <span class="h4 fw-bold text-dark mb-0">₹@Model.CurrentSavedAmount.ToString("N2")</span>
                        <span class="text-muted"> of ₹@Model.TargetAmount.ToString("N2")</span>
                    </div>
                    <span class="h5 fw-bold text-primary mb-0">@Model.ProgressPercentage.ToString("N1")%</span>
                </div>
                <div class="progress" style="height: 14px; border-radius: 7px;">
                    <div class="progress-bar @(Model.IsCompleted ? "bg-success" : "bg-primary")" role="progressbar" style="width: @Model.ProgressPercentage%;" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                    <span>Remaining: <strong>₹@Model.RemainingAmount.ToString("N2")</strong></span>
                    <span>@Model.DaysRemaining days remaining</span>
                </div>
            </div>

            <!-- Savings Schedule Breakdown -->
            <h6 class="fw-bold text-dark text-uppercase small mb-3">Required Savings Schedule</h6>
            <div class="row g-3 text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Monthly Deposit</div>
                        <div class="h5 fw-bold text-success mb-0">₹@Model.RequiredMonthlySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(@Model.MonthsRemaining months)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Weekly Deposit</div>
                        <div class="h5 fw-bold text-primary mb-0">₹@Model.RequiredWeeklySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(7-day target)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Daily Deposit</div>
                        <div class="h5 fw-bold text-secondary mb-0">₹@Model.RequiredDailySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(Daily micro-saving)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Deposit & Notification Trigger Box -->
    <div class="col-lg-5">
        <div class="stat-card p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-wallet2 text-success me-2"></i> Quick Deposit</h5>
            <form asp-controller="Savings" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SavingGoalId" value="@Model.Id" />
                <input type="hidden" name="GoalName" value="@Model.GoalName" />
                <input type="hidden" name="TargetAmount" value="@Model.TargetAmount" />
                <input type="hidden" name="CurrentSavedAmount" value="@Model.CurrentSavedAmount" />

                <div class="mb-3">
                    <label class="form-label small fw-bold">Deposit Amount (₹)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">₹</span>
                        <input type="number" name="Amount" class="form-control" value="@(Model.RequiredMonthlySaving > 0 ? Math.Min(Model.RequiredMonthlySaving, Model.RemainingAmount) : Math.Min(1000m, Model.RemainingAmount))" min="1" step="100" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Notes (Optional)</label>
                    <input type="text" name="Notes" class="form-control" placeholder="e.g. Salary savings, Cashback bonus" />
                </div>

                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 shadow-sm" @(Model.IsCompleted ? "disabled" : "")>
                    <i class="bi bi-check2-circle me-1"></i> @(Model.IsCompleted ? "Goal Completed!" : "Add Savings Deposit")
                </button>
            </form>
        </div>

        <!-- Goal Management -->
        <div class="stat-card p-3 border-danger bg-danger-light">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-danger mb-0">Delete Goal</h6>
                    <span class="text-muted small">Remove this goal and its savings log</span>
                </div>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this saving goal? All its savings records will also be deleted.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Savings Transaction History -->
<div class="stat-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-receipt text-primary me-2"></i> Savings History Log
        </h5>
        <span class="badge bg-light text-dark border">@Model.SavingsHistory.Count deposits recorded</span>
    </div>

    @if (Model.SavingsHistory.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sav in Model.SavingsHistory)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-calendar-event text-muted me-1"></i>
                                @sav.SavedDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <span class="fw-bold text-success">+₹@sav.Amount.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="text-muted">@(string.IsNullOrEmpty(sav.Notes) ? "—" : sav.Notes)</span>
                            </td>
                            <td class="text-end">
                                <form asp-controller="Savings" asp-action="Delete" asp-route-id="@sav.Id" asp-route-goalId="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this deposit record?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger p-0" title="Delete deposit">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4 bg-light rounded-3">
            <i class="bi bi-piggy-bank text-muted fs-3"></i>
            <p class="text-muted small mt-2 mb-0">No savings transactions logged yet. Add your first deposit above!</p>
        </div>
    }
</div>
