@model PocketGoal.ViewModels.SavingGoalViewModel
@{
    ViewData["Title"] = Model.GoalName + " - Goal Details";
}

<!-- Page Header & Breadcrumb -->
<div class="mb-4">
    <div class="pg-breadcrumb">
        <a asp-action="Index"><i class="bi bi-bullseye"></i> Saving Goals</a>
        <span class="pg-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
        <span class="pg-breadcrumb-current">@Model.GoalName</span>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 class="fw-bold text-dark mb-0">@Model.GoalName</h2>
        <div class="d-flex gap-2 flex-wrap flex-sm-nowrap w-100 w-sm-auto">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-grow-1 flex-sm-grow-0" aria-label="Edit @Model.GoalName">
                <i class="bi bi-pencil-square me-1"></i> Edit Goal
            </a>
            @if (!Model.IsCompleted)
            {
                <a asp-controller="Savings" asp-action="Add" asp-route-goalId="@Model.Id" class="btn btn-success btn-sm rounded-pill px-3 flex-grow-1 flex-sm-grow-0" aria-label="Add deposit to @Model.GoalName">
                    <i class="bi bi-plus-circle me-1"></i> Add Deposit
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Goal Metrics Card -->
    <div class="col-12 col-lg-7">
        <div class="stat-card p-3 p-sm-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <span class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-calendar3 me-1 text-primary"></i> Target: @Model.TargetDate.ToString("MMMM dd, yyyy")
                </span>
                <div>
                    @if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.Completed)
                    {
                        <span class="badge-pace-completed"><i class="bi bi-check-circle-fill"></i> Completed 🎉</span>
                    }
                    else if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.OnTrack)
                    {
                        <span class="badge-pace-ontrack"><i class="bi bi-speedometer"></i> On Track 🚀</span>
                    }
                    else if (Model.PaceStatus == PocketGoal.Models.GoalPaceStatus.Behind)
                    {
                        <span class="badge-pace-behind"><i class="bi bi-exclamation-triangle-fill"></i> Behind Pace ⚠️</span>
                    }
                    else
                    {
                        <span class="badge-pace-overdue"><i class="bi bi-clock-history"></i> Past Due ⏰</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted mb-4 small">@Model.Description</p>
            }

            <!-- Progress Bar -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-baseline mb-2 flex-wrap gap-1">
                    <div>
                        <span class="h4 fw-bold text-dark mb-0">₹@Model.CurrentSavedAmount.ToString("N2")</span>
                        <span class="text-muted small"> of ₹@Model.TargetAmount.ToString("N2")</span>
                    </div>
                    <span class="h5 fw-bold text-primary mb-0">@Model.ProgressPercentage.ToString("N1")%</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar @(Model.IsCompleted ? "bg-success" : "bg-primary")" role="progressbar" style="width: @Model.ProgressPercentage%;" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100" aria-label="Goal Progress"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted flex-wrap gap-1">
                    <span>Balance to save: <strong class="text-dark">₹@Model.RemainingAmount.ToString("N2")</strong></span>
                    <span><i class="bi bi-hourglass-split text-warning me-1"></i> Innum @Model.DaysRemaining days dhaan irukku</span>
                </div>
            </div>

            <!-- Savings Schedule Breakdown -->
            <h6 class="fw-bold text-dark text-uppercase small mb-3" style="letter-spacing: 0.04em;">Required Savings Plan</h6>
            <div class="row g-3 text-center">
                <div class="col-12 col-sm-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Monthly Deposit</div>
                        <div class="h5 fw-bold text-success mb-0 mt-1">₹@Model.RequiredMonthlySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(@Model.MonthsRemaining months)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Weekly Deposit</div>
                        <div class="h5 fw-bold text-primary mb-0 mt-1">₹@Model.RequiredWeeklySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(7-day target)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Daily Deposit</div>
                        <div class="h5 fw-bold text-secondary mb-0 mt-1">₹@Model.RequiredDailySaving.ToString("N0")</div>
                        <div class="text-muted" style="font-size: 0.75rem;">(Daily micro-saving)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Deposit & Goal Management Box -->
    <div class="col-12 col-lg-5">
        <div class="stat-card p-3 p-sm-4 mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-wallet2 text-success me-2"></i> Quick Deposit 💰</h5>
            <form asp-controller="Savings" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SavingGoalId" value="@Model.Id" />
                <input type="hidden" name="GoalName" value="@Model.GoalName" />
                <input type="hidden" name="TargetAmount" value="@Model.TargetAmount" />
                <input type="hidden" name="CurrentSavedAmount" value="@Model.CurrentSavedAmount" />

                <div class="mb-3">
                    <label class="form-label small fw-bold" for="quickDepositAmount">Deposit Amount (₹)</label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">₹</span>
                        <input type="number" id="quickDepositAmount" name="Amount" class="form-control" inputmode="numeric" value="@(Model.RequiredMonthlySaving > 0 ? Math.Min(Model.RequiredMonthlySaving, Model.RemainingAmount) : Math.Min(1000m, Model.RemainingAmount))" min="1" step="100" required />
                    </div>

                    <!-- Quick Amount Preset Chips -->
                    @if (!Model.IsCompleted)
                    {
                        <div class="quick-chip-group">
                            <span class="quick-chip quick-chip-success" data-target-input="quickDepositAmount" data-amount="500">+₹500</span>
                            <span class="quick-chip quick-chip-success" data-target-input="quickDepositAmount" data-amount="1000">+₹1,000</span>
                            <span class="quick-chip quick-chip-success" data-target-input="quickDepositAmount" data-amount="2000">+₹2,000</span>
                            @if (Model.RemainingAmount > 0)
                            {
                                <span class="quick-chip quick-chip-success" data-target-input="quickDepositAmount" data-amount="@Model.RemainingAmount">Full Remaining (₹@Model.RemainingAmount.ToString("N0"))</span>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold" for="quickDepositNotes">Notes (Optional)</label>
                    <input type="text" id="quickDepositNotes" name="Notes" class="form-control" placeholder="e.g. Monthly salary contribution" />
                </div>

                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 shadow-sm" data-loading-text="Adding Deposit..." @(Model.IsCompleted ? "disabled" : "")>
                    <i class="bi bi-check2-circle me-1"></i> @(Model.IsCompleted ? "Goal Already Completed! 🎉" : "Add Deposit")
                </button>
            </form>
        </div>

        <!-- Goal Management -->
        <div class="stat-card p-3 border-danger bg-danger-light">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <div>
                    <h6 class="fw-bold text-danger mb-0">Delete Saving Goal</h6>
                    <span class="text-muted small">Indha goal and @Model.SavingsHistory.Count deposits history remove aagidum</span>
                </div>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill w-100 w-sm-auto" 
                            data-bs-confirm="true"
                            data-confirm-title="Delete Saving Goal: @Model.GoalName"
                            data-confirm-message="Indha saving goal '<strong>@Model.GoalName</strong>' and adhula irukka <strong>@Model.SavingsHistory.Count deposits records</strong> ellam delete aagidum. Confirm panriya?"
                            data-confirm-btn-text="Yes, Delete Goal"
                            aria-label="Delete Goal @Model.GoalName">
                        <i class="bi bi-trash"></i> Delete Goal
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Savings Transaction History -->
<div class="stat-card p-3 p-sm-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-receipt text-primary me-2"></i> Savings History Log 📜
        </h5>
        <span class="badge bg-light text-dark border px-2 py-1">@Model.SavingsHistory.Count deposits recorded</span>
    </div>

    @if (Model.SavingsHistory.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sav in Model.SavingsHistory)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-calendar-event text-muted me-1"></i>
                                @sav.SavedDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <span class="fw-bold text-success">+₹@sav.Amount.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="text-muted small">@(string.IsNullOrEmpty(sav.Notes) ? "—" : sav.Notes)</span>
                            </td>
                            <td class="text-end">
                                <form asp-controller="Savings" asp-action="Delete" asp-route-id="@sav.Id" asp-route-goalId="@Model.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-link text-danger p-2" 
                                            data-bs-confirm="true"
                                            data-confirm-title="Delete Savings Deposit"
                                            data-confirm-message="Indha <strong>₹@sav.Amount.ToString("N2")</strong> deposit record-ah delete panna poriya? Un goal progress adjust aagidum."
                                            data-confirm-btn-text="Yes, Delete Deposit"
                                            aria-label="Delete deposit of ₹@sav.Amount.ToString("N2") from @sav.SavedDate.ToString("MMM dd")"
                                            title="Delete deposit">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-3">
            <i class="bi bi-piggy-bank text-muted display-4"></i>
            <h6 class="fw-bold text-dark mt-2">No Deposits Recorded Yet</h6>
            <p class="text-muted small mb-3">Un first contribution add panni goal progress meter-ah start pannu!</p>
            @if (!Model.IsCompleted)
            {
                <a asp-controller="Savings" asp-action="Add" asp-route-goalId="@Model.Id" class="btn btn-success btn-sm rounded-pill px-4">
                    <i class="bi bi-plus-lg me-1"></i> Add First Deposit
                </a>
            }
        </div>
    }
</div>


