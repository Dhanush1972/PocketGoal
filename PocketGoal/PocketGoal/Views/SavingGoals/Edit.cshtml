@model PocketGoal.ViewModels.SavingGoalCreateEditViewModel
@{
    ViewData["Title"] = "Edit Saving Goal";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Edit Saving Goal</h3>
                <p class="text-muted small">Un goal target and timeline update pannikonga</p>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="GoalName" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="GoalName" class="form-control" />
                    <span asp-validation-for="GoalName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetAmount" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">₹</span>
                        <input asp-for="TargetAmount" class="form-control" type="number" step="100" min="1" />
                    </div>
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetDate" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="TargetDate" class="form-control" type="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="TargetDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="1">Active</option>
                        <option value="2">Completed</option>
                        <option value="3">Paused</option>
                        <option value="4">Cancelled</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional notes or details"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4 text-center">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">
                        <i class="bi bi-check-lg me-1"></i> Update Goal ✅
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
