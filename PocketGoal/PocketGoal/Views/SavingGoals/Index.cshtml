@model List<PocketGoal.ViewModels.SavingGoalViewModel>
@{
    ViewData["Title"] = "Saving Goals";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Un Saving Goals</h2>
        <p class="text-muted mb-0">Un target purchases, savings progress, and monthly plan ellam inga paathuko.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> + Pudhu Goal Create Pannu
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var goal in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="stat-card d-flex flex-column justify-content-between">
                    <div>
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@goal.GoalName</h5>
                                <div class="text-muted small">Target: @goal.TargetDate.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div>
                                @if (goal.PaceStatus == PocketGoal.Models.GoalPaceStatus.Completed)
                                {
                                    <span class="badge-pace-completed"><i class="bi bi-check-circle-fill"></i> Mudinjadhu! 🎉</span>
                                }
                                else if (goal.PaceStatus == PocketGoal.Models.GoalPaceStatus.OnTrack)
                                {
                                    <span class="badge-pace-ontrack"><i class="bi bi-speedometer"></i> On Track 🚀</span>
                                }
                                else if (goal.PaceStatus == PocketGoal.Models.GoalPaceStatus.Behind)
                                {
                                    <span class="badge-pace-behind"><i class="bi bi-exclamation-triangle-fill"></i> Konjam Slow ⚠️</span>
                                }
                                else
                                {
                                    <span class="badge-pace-overdue"><i class="bi bi-clock-history"></i> Date Aachu ⏰</span>
                                }
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="fw-bold text-dark">₹@goal.CurrentSavedAmount.ToString("N0")</span>
                                <span class="text-muted small">of ₹@goal.TargetAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar @(goal.IsCompleted ? "bg-success" : "bg-primary")" role="progressbar" style="width: @goal.ProgressPercentage%;" aria-valuenow="@goal.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="text-muted small">@goal.ProgressPercentage.ToString("N1")% funded</span>
                                <span class="text-muted small">Balance: ₹@goal.RemainingAmount.ToString("N0")</span>
                            </div>
                        </div>

                        <!-- Calculation Box -->
                        @if (!goal.IsCompleted)
                        {
                            <div class="p-2 bg-light rounded-3 border mb-3 text-center">
                                <span class="text-muted small d-block">Monthly Deposit Target</span>
                                <span class="h6 fw-bold text-success mb-0">₹@goal.RequiredMonthlySaving.ToString("N0") / mo</span>
                            </div>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top gap-2">
                        <a asp-action="Details" asp-route-id="@goal.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 flex-grow-1">
                            Plan & History Paaru
                        </a>
                        @if (!goal.IsCompleted)
                        {
                            <a asp-controller="Savings" asp-action="Add" asp-route-goalId="@goal.Id" class="btn btn-success btn-sm rounded-pill px-3">
                                + Save
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 stat-card">
        <div class="brand-icon mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
            <i class="bi bi-bullseye"></i>
        </div>
        <h4 class="fw-bold text-dark">Innum Goal Onnum Add Pannala Da</h4>
        <p class="text-muted">Enna vanga poriyo adha target set panni savings start pannuvoma?</p>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow">
            <i class="bi bi-plus-lg me-1"></i> First Goal Create Pannu 🚀
        </a>
    </div>
}
