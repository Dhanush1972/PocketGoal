@model PocketGoal.ViewModels.AddSavingViewModel
@{
    ViewData["Title"] = "Add Savings Deposit";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="stat-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="stat-icon bg-success-light text-success mx-auto mb-2" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Savings Deposit Add Pannu</h3>
                <p class="text-muted small mb-0">Goal-kaga contribute panrom: <strong class="text-primary">@Model.GoalName</strong></p>
            </div>

            <!-- Current Progress Banner -->
            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small">Current Saved: <strong>₹@Model.CurrentSavedAmount.ToString("N0")</strong></span>
                    <span class="text-muted small">Target: <strong>₹@Model.TargetAmount.ToString("N0")</strong></span>
                </div>
                <div class="progress" style="height: 8px; border-radius: 4px;">
                    @{
                        var pct = Model.TargetAmount > 0 ? (Model.CurrentSavedAmount / Model.TargetAmount * 100m) : 0m;
                    }
                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="text-end mt-1">
                    <span class="text-muted small">Balance to save: <strong class="text-dark">₹@Model.RemainingAmount.ToString("N0")</strong></span>
                </div>
            </div>

            <form asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SavingGoalId" />
                <input type="hidden" asp-for="GoalName" />
                <input type="hidden" asp-for="TargetAmount" />
                <input type="hidden" asp-for="CurrentSavedAmount" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">₹</span>
                        <input asp-for="Amount" class="form-control" type="number" step="100" min="1" autofocus />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SavedDate" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="SavedDate" class="form-control" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="SavedDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" placeholder="e.g. Monthly salary savings, Freelance bonus, Cashback" />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="SavingGoals" asp-action="Details" asp-route-id="@Model.SavingGoalId" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow">
                        <i class="bi bi-plus-lg me-1"></i> + Deposit Add Pannu ✅
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
