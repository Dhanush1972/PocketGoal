@model PocketGoal.ViewModels.AddSavingViewModel
@{
    ViewData["Title"] = "Add Savings Deposit";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-12 col-md-8 col-lg-6">
        <!-- Breadcrumb -->
        <div class="pg-breadcrumb mb-3">
            <a asp-controller="SavingGoals" asp-action="Index"><i class="bi bi-bullseye"></i> Saving Goals</a>
            <span class="pg-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
            <a asp-controller="SavingGoals" asp-action="Details" asp-route-id="@Model.SavingGoalId">@Model.GoalName</a>
            <span class="pg-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
            <span class="pg-breadcrumb-current">Add Deposit</span>
        </div>

        <div class="stat-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="stat-icon bg-success-light text-success mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Add Savings Deposit</h3>
                <p class="text-muted small mb-0">Goal-kaga contribute panrom: <strong class="text-primary">@Model.GoalName</strong></p>
            </div>

            <!-- Current Progress Banner -->
            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                    <span class="text-muted small">Current Saved: <strong class="text-dark">₹@Model.CurrentSavedAmount.ToString("N0")</strong></span>
                    <span class="text-muted small">Target: <strong class="text-dark">₹@Model.TargetAmount.ToString("N0")</strong></span>
                </div>
                <div class="progress" style="height: 8px;">
                    @{
                        var pct = Model.TargetAmount > 0 ? (Model.CurrentSavedAmount / Model.TargetAmount * 100m) : 0m;
                    }
                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Goal Progress"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 small">
                    <span class="text-muted">@pct.ToString("N1")% saved</span>
                    <span class="text-muted">Balance: <strong class="text-dark">₹@Model.RemainingAmount.ToString("N0")</strong></span>
                </div>
            </div>

            <form asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SavingGoalId" />
                <input type="hidden" asp-for="GoalName" />
                <input type="hidden" asp-for="TargetAmount" />
                <input type="hidden" asp-for="CurrentSavedAmount" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">₹</span>
                        <input asp-for="Amount" id="depositAmountInput" class="form-control" type="number" inputmode="numeric" step="100" min="1" placeholder="e.g. 1000" autofocus />
                    </div>
                    <!-- Quick Deposit Chips -->
                    <div class="quick-chip-group">
                        <span class="quick-chip quick-chip-success" data-target-input="depositAmountInput" data-amount="500">+₹500</span>
                        <span class="quick-chip quick-chip-success" data-target-input="depositAmountInput" data-amount="1000">+₹1,000</span>
                        <span class="quick-chip quick-chip-success" data-target-input="depositAmountInput" data-amount="2000">+₹2,000</span>
                        <span class="quick-chip quick-chip-success" data-target-input="depositAmountInput" data-amount="5000">+₹5,000</span>
                        @if (Model.RemainingAmount > 0)
                        {
                            <span class="quick-chip quick-chip-success" data-target-input="depositAmountInput" data-amount="@Model.RemainingAmount">Full Balance (₹@Model.RemainingAmount.ToString("N0"))</span>
                        }
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SavedDate" class="form-label"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                        <input asp-for="SavedDate" class="form-control" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="SavedDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" placeholder="e.g. Saved from weekend budget" />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-2">
                    <a asp-controller="SavingGoals" asp-action="Details" asp-route-id="@Model.SavingGoalId" class="btn btn-outline-secondary rounded-pill px-4 text-center">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow" data-loading-text="Adding Deposit...">
                        <i class="bi bi-plus-lg me-1"></i> Add Deposit ✅
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


