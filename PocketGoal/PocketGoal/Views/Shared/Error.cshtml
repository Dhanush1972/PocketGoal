@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center my-2 my-md-4">
    <div class="col-12 col-lg-8">
        <div class="stat-card p-3 p-sm-4 p-md-5 text-center">
            <div class="stat-icon bg-danger-light text-danger mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.75rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">An error occurred while processing your request.</h3>
            <p class="text-muted small mb-4">Something went wrong. Don't worry, un data safe-ah dhaan irukku.</p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded-3 border mb-4 text-start">
                    <span class="text-muted small"><strong>Request ID:</strong> <code>@Model.RequestId</code></span>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

