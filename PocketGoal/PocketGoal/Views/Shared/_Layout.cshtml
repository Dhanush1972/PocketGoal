@inject PocketGoal.Services.IProfileContextService ProfileContext
@inject PocketGoal.Services.IUserProfileService UserProfileService
@{
    var activeUserId = ProfileContext.GetCurrentUserId();
    PocketGoal.Models.UserProfile? activeUser = null;
    if (activeUserId.HasValue)
    {
        activeUser = await UserProfileService.GetUserProfileAsync(activeUserId.Value);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PocketGoal | Personal Finance & Savings Tracker</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar sticky-top py-2">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-wallet2"></i></span>
                    <span class="fw-bold">Pocket<span class="text-dark">Goal</span></span>
                </a>

                <button class="navbar-toggler border-0 p-2 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (activeUser != null)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-pie-chart-fill"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SavingGoals" ? "active" : "")" asp-controller="SavingGoals" asp-action="Index">
                                    <i class="bi bi-bullseye"></i>
                                    <span>Saving Goals</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Expenses" ? "active" : "")" asp-controller="Expenses" asp-action="Index">
                                    <i class="bi bi-credit-card-2-front-fill"></i>
                                    <span>Expenses</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell-fill"></i>
                                    <span>Reminders</span>
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                            <!-- Active User Profile Dropdown -->
                            <div class="dropdown">
                                <button class="user-profile-btn dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar">
                                        @activeUser.Name.Substring(0, Math.Min(1, activeUser.Name.Length)).ToUpper()
                                    </div>
                                    <span class="fw-semibold text-dark small">@activeUser.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2" style="min-width: 240px; border-radius: var(--pg-radius-md);">
                                    <li class="px-3 py-2 bg-light rounded-2 mb-2">
                                        <div class="fw-bold text-dark">@activeUser.Name</div>
                                        <div class="text-muted small text-truncate">@activeUser.Email</div>
                                        <div class="text-muted small text-truncate">@activeUser.PhoneNumber</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Switch">
                                            <i class="bi bi-arrow-left-right text-muted"></i>
                                            <span>Switch Profile</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Profile" asp-action="Clear" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded-2 py-2 text-danger d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>Sign Out / Clear Profile</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Switch">
                                    <i class="bi bi-people"></i>
                                    <span>Switch Profile</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Profile" asp-action="Onboarding">
                                    <i class="bi bi-rocket-takeoff-fill me-1"></i> Get Started
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-3 my-md-4">
        <!-- Notification Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="text-center text-sm-start">
                &copy; @DateTime.UtcNow.Year <strong class="text-dark">PocketGoal</strong> &bull; Un Personal Finance & Savings Partner
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-database-check me-1 text-primary"></i> PostgreSQL / Supabase</span>
                <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none hover-primary">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
